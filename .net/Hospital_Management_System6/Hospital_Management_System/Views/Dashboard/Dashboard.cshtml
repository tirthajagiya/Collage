@model Hospital_Management_System.Models.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container mx-auto py-6 px-3">
    <div class="text-center mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-blue-600">Dashboard</h1>
        <p class="text-gray-500">Key statistics</p>
        <div class="w-24 h-1 bg-blue-500 mx-auto mt-3 rounded"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-white rounded-xl shadow p-4 flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-blue-600 text-white flex items-center justify-center">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <div class="text-gray-500 text-sm">Total Users</div>
                <div class="text-xl font-bold">@Model.TotalUsers</div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow p-4 flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-green-600 text-white flex items-center justify-center">
                <i class="bi bi-person-badge"></i>
            </div>
            <div>
                <div class="text-gray-500 text-sm">Total Doctors</div>
                <div class="text-xl font-bold">@Model.TotalDoctors</div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow p-4 flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-red-600 text-white flex items-center justify-center">
                <i class="bi bi-hospital"></i>
            </div>
            <div>
                <div class="text-gray-500 text-sm">Total Patients</div>
                <div class="text-xl font-bold">@Model.TotalPatients</div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow p-4 flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-amber-500 text-white flex items-center justify-center">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <div>
                <div class="text-gray-500 text-sm">Total Appointments</div>
                <div class="text-xl font-bold">@Model.TotalAppointments</div>
            </div>
        </div>
        <div class="bg-white rounded-xl shadow p-4 flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-cyan-600 text-white flex items-center justify-center">
                <i class="bi bi-diagram-3"></i>
            </div>
            <div>
                <div class="text-gray-500 text-sm">Total Departments</div>
                <div class="text-xl font-bold">@Model.TotalDepartments</div>
            </div>
        </div>
    </div>
</div>