@model Hospital_Management_System.Models.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container py-4">
    <!-- Hospital Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">CityCare Hospital</h1>
        <p class="lead text-muted">Hospital Management System Dashboard</p>
        <hr class="w-25 mx-auto">
    </div>

    <!-- Welcome Message -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body text-center py-4">
                    <h3 class="fw-bold text-primary mb-2">Welcome to Hospital Management System</h3>
                    <p class="text-muted mb-0">Here's an overview of your hospital's key statistics</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Statistics Cards -->
    <div class="row g-4 mb-4">
        <!-- Total Users Card -->
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body text-center p-4">
                    <div class="icon-box bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width:80px; height:80px;">
                        <i class="bi bi-people fs-2"></i>
                    </div>
                    <h2 class="fw-bold text-primary mb-2">@Model.TotalUsers</h2>
                    <h5 class="text-muted mb-3">Total Users</h5>
                    <p class="text-muted small">Registered users in the system</p>
                    <a asp-controller="User" asp-action="UserList" class="btn btn-outline-primary">
                        <i class="bi bi-eye me-1"></i> View Users
                    </a>
                </div>
            </div>
        </div>

        <!-- Total Doctors Card -->
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body text-center p-4">
                    <div class="icon-box bg-success text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width:80px; height:80px;">
                        <i class="bi bi-person-badge fs-2"></i>
                    </div>
                    <h2 class="fw-bold text-success mb-2">@Model.TotalDoctors</h2>
                    <h5 class="text-muted mb-3">Total Doctors</h5>
                    <p class="text-muted small">Medical professionals in the hospital</p>
                    <a asp-controller="Doctor" asp-action="DoctorList" class="btn btn-outline-success">
                        <i class="bi bi-eye me-1"></i> View Doctors
                    </a>
                </div>
            </div>
        </div>

        <!-- Total Appointments Card -->
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body text-center p-4">
                    <div class="icon-box bg-info text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width:80px; height:80px;">
                        <i class="bi bi-calendar-check fs-2"></i>
                    </div>
                    <h2 class="fw-bold text-info mb-2">@Model.TotalAppointments</h2>
                    <h5 class="text-muted mb-3">Total Appointments</h5>
                    <p class="text-muted small">All scheduled appointments</p>
                    <a asp-controller="Appointment" asp-action="AppointmentList" class="btn btn-outline-info">
                        <i class="bi bi-eye me-1"></i> View Appointments
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-primary mb-3">
                        <i class="bi bi-lightning me-2"></i>Quick Actions
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-3 col-sm-6">
                            <a asp-controller="User" asp-action="UserAddEdit" class="btn btn-primary w-100">
                                <i class="bi bi-person-plus me-2"></i>Add User
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a asp-controller="Doctor" asp-action="DoctorAddEdit" class="btn btn-success w-100">
                                <i class="bi bi-person-badge me-2"></i>Add Doctor
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a asp-controller="Appointment" asp-action="AppointmentAddEdit" class="btn btn-info w-100">
                                <i class="bi bi-calendar-plus me-2"></i>Book Appointment
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a asp-controller="Patient" asp-action="PatientAddEdit" class="btn btn-warning w-100">
                                <i class="bi bi-person-heart me-2"></i>Add Patient
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-box {
        transition: transform 0.3s ease;
    }
    
    .card:hover .icon-box {
        transform: scale(1.1);
    }
    
    .card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
    }
    
    .btn {
        transition: all 0.3s ease;
    }
    
    .btn:hover {
        transform: translateY(-2px);
    }
</style>